  "journey": {
    "objective": "以旧船离开井星，在萨迦恢复轮坠历，并在第一次轮坠时返回完成中和层校准。",
    "well_departure": {
      "route_id": "repair-old-ship",
      "system_text": "航行条件恢复。指定目标：无。",
      "recorded_consequences": [
        "井星仍有共同下方。",
        "砾以维修与航路知识同行。",
        "旧船修复使用的材料与维修记录保留在船上。"
      ]
    },
    "saga_arrival": {
      "location_id": "saga.outer-day-city",
      "local_fact": "内外两套文明向相反方向生活；唯一坠核正在偏向一侧。",
      "voices": [
        {
          "speaker": "岫",
          "position": "外昼城定向官",
          "claim": "永久向外定向能保住人口与工业。"
        },
        {
          "speaker": "反枝",
          "position": "内海穹引水者",
          "claim": "内海无法整体迁移，外面不能把灾害称为必要代价。"
        },
        {
          "speaker": "央",
          "position": "无下城摆渡人",
          "claim": "中间也是一个地方，翻转的代价必须被共同承担。"
        }
      ]
    },
    "rotation_calendar": {
      "route_id": "rebuild-rotation-calendar",
      "required_sequence": [
        {
          "id": "outer-light-clock",
          "location_id": "saga.outer-day-city",
          "player_operation": "在外昼光钟中重接定向刻度，使外层设施能预报第一次翻转。"
        },
        {
          "id": "inner-tide-clock",
          "location_id": "saga.inner-sea-dome",
          "player_operation": "在内海潮钟中校准水体锚链，记录翻转前的撤离窗口。"
        },
        {
          "id": "neutral-free-gyroscope",
          "location_id": "saga.no-down-city",
          "player_operation": "在无下城自由陀仪上同步两面周期，建立中和层的共同时间基准。"
        }
      ],
      "resolution": {
        "state_changes": {
          "saga.rotation_calendar_restored": true,
          "saga.core_removed": false,
          "saga.witness.category": "gravity-and-direction",
          "saga.witness.acquisition": "granted"
        },
        "system_text": "轮坠历恢复。共同下方将按历法轮换；事故风险未归零。",
        "world_consequences": [
          "外昼城与内海穹必须重建适应翻转的居住结构。",
          "无下城成为维护历法与分配撤离窗口的共同节点。",
          "极端派可能离开、阻挠或破坏历轴。"
        ]
      }
    },
    "revisit": {
      "event_id": "first-rotation",
      "entry_requirements": {
        "required_states": [
          "well.old_ship_repaired",
          "saga.rotation_calendar_restored"
        ],
        "minimum_travel_ticks": 1
      },
      "location_id": "saga.no-down-city",
      "visible_consequences": [
        "外昼城在翻转前转入临时锚定，工业航路缩短。",
        "内海穹提前释放部分水体进入缓冲带，居民必须按潮钟迁移。",
        "无下城承受两面物流与维护人员的集中压力。",
        "极端派破坏一段历轴，试图证明轮坠历不能成立。"
      ],
      "required_action": {
        "id": "neutral-layer-stabilization",
        "player_operation": "在中和层重连被破坏的历轴，将外昼光钟与内海潮钟的实时读数重新同步。",
        "result": "第一次翻转按预测完成；损失与事故被记录，但两面都无法把风险外包给对方。"
      },
      "system_text": "共存是持续维护，不是静态两全。"
    }
  },
