* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Godot and source assets remain diffable.
*.gd text
*.tscn text
*.tres text
*.godot text
*.gdextension text
*.json text
*.po text

# Large binary assets use Git LFS.
*.docx filter=lfs diff=lfs merge=lfs -text
